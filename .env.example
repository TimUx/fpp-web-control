# Beispielkonfiguration fuer die Flask-gestuetzte FPP-Steuerung
# Werte nach Bedarf anpassen und als ".env" verwenden.

# ==========================================
# SITE SETTINGS
# ==========================================
SITE_NAME="🎄 Meine Lichtershow 🎄"
# Kurzbeschreibung für Suchmaschinen und Link-Vorschauen (WhatsApp usw.)
SITE_DESCRIPTION="Lichtershow starten, Lieder wünschen und die Musik direkt am Handy hören."
# Optional: vollständige URL eines Vorschaubilds für geteilte Links (ca. 1200x630)
SITE_IMAGE_URL=
SITE_SUBTITLE="📅 Dezember 2025 📅\n⏰ Täglich 17-21 Uhr ⏰\n🏠 Musterstraße 1, Musterstadt 🏠"
# Fester Zugangscode (leer = keiner). Alternative: Tagescode an der Matrix, siehe unten.
ACCESS_CODE=
PREVIEW_MODE=false

# ==========================================
# FPP CONNECTION
# ==========================================
FPP_BASE_URL=http://fpp.local
FPP_POLL_INTERVAL_MS=15000
CLIENT_STATUS_POLL_MS=10000

# ==========================================
# TAGESCODE AN DER PIXEL-MATRIX (optional, ersetzt den Code auf dem Schild)
# Der Zugangscode wechselt täglich und wird an einem FPP-Overlay-Modell
# angezeigt, solange nichts läuft. Nur wer vor dem Haus steht, kann ihn lesen.
# ==========================================
# Name des Overlay-Modells in FPP (leer = Funktion aus)
CODE_MATRIX_MODEL=
# Anzahl Ziffern (2-6; muss auf die Matrix passen, 36x25 Pixel = 3 Ziffern)
CODE_MATRIX_DIGITS=3
# Farbe der Ziffern (#RRGGBB)
CODE_MATRIX_COLOR="#FFFFFF"
# Tatsächliche Verkabelung der Matrix, falls FPP das Modell anders beschreibt
# (leer = Werte aus FPP). Beispiel 36x25 aus 3 Strings mit je 12 senkrechten
# Strängen, Start unten links: STRINGS=3, STRANDS_PER_STRING=12, ORIENTATION=V, START_CORNER=BL
CODE_MATRIX_STRINGS=
CODE_MATRIX_STRANDS_PER_STRING=
CODE_MATRIX_ORIENTATION=
CODE_MATRIX_START_CORNER=
# Geheimnis, aus dem der Tagescode berechnet wird (leer = wird einmalig erzeugt
# und in data/code_secret gespeichert; auch als CODE_SECRET_FILE möglich)
CODE_SECRET=
# Eigener Hinweistext über dem Eingabefeld (leer = Standardtext)
ACCESS_HINT=
# Hinweis: ACCESS_CODE bleibt zusätzlich gültig, solange er gesetzt ist.

# ==========================================
# FALCONBEAT (Musik synchron auf dem Besucher-Gerät, optional)
# Benötigt das FPP-Plugin "fpp-plugin-FalconBeat" + einen FalconBeat-Server
# und eine Reverse-Proxy-Regel, siehe deploy/README.md
# ==========================================
# auto = Lautsprecher-Button erscheint, wenn das Plugin installiert + aktiv ist
# on   = Plugin-Prüfung überspringen (FALCONBEAT_SERVER_URL muss gesetzt sein)
# off  = Funktion abschalten
FALCONBEAT_MODE=auto
# Adresse des FalconBeat-Servers aus Sicht dieses Containers (nur Health-Check).
# Leer = Adresse aus den Plugin-Einstellungen ("Server (LAN)") übernehmen.
FALCONBEAT_SERVER_URL=
# Pfad (oder URL), unter dem der Browser /ws und /media/* des FalconBeat-Servers erreicht
FALCONBEAT_CLIENT_BASE=/falconbeat

# ==========================================
# DOCKER SECRETS
# Jede Variable kann alternativ als <NAME>_FILE gesetzt werden, z.B.
# ACCESS_CODE_FILE=/run/secrets/fpp_access_code
# ==========================================

# ==========================================
# PLAYLISTS
# ==========================================
FPP_PLAYLIST_1=show
FPP_PLAYLIST_2=kids
FPP_PLAYLIST_REQUESTS=wishlist
# Name des FPP-Effekts, der im Leerlauf läuft (leer = keiner)
FPP_BACKGROUND_EFFECT=background

# ==========================================
# SHOW PERIOD (Zeitraum & Showzeiten)
# ==========================================
# Datumsbereich für automatisches Scheduling (Format: YYYY-MM-DD)
FPP_SHOW_START_DATE=2025-12-01
FPP_SHOW_END_DATE=2026-01-06

# Tägliche Showzeiten (Format: HH:MM)
# Außerhalb dieser Zeiten sind Buttons deaktiviert
FPP_SHOW_START_TIME=16:30
FPP_SHOW_END_TIME=22:00

# Zeitgesteuerte Shows aktivieren/deaktivieren (true/false)
# Wenn true (Standard): Shows werden zu den geplanten Zeiten automatisch gestartet
# Wenn false: Keine automatischen Shows, nur manuelle Steuerung möglich
SCHEDULED_SHOWS_ENABLED=true

# Zeitplan der automatischen Shows: UHRZEIT=PLAYLIST, durch Komma getrennt.
# PLAYLIST ist "playlist1", "playlist2" oder der Name einer FPP-Playlist.
# Leer = Standard (17:00 Playlist 2, 18:00-21:00 stündlich Playlist 1).
FPP_SHOW_SCHEDULE=17:00=playlist2,18:00=playlist1,19:00=playlist1,20:00=playlist1,21:00=playlist1

# Fairness bei Liedwünschen (0 = unbegrenzt)
# Wie viele Wünsche ein Gerät gleichzeitig in der Warteschlange haben darf
MAX_WISHES_PER_DEVICE=2
# Wie lang die Warteschlange insgesamt werden darf
MAX_QUEUE_LENGTH=10

# Statistik-Einträge nach N Tagen löschen (0 = nie löschen)
STATISTICS_RETENTION_DAYS=0

# ==========================================
# BUTTON TEXTS
# ==========================================
BUTTON_PLAYLIST_1=Show starten
BUTTON_PLAYLIST_2=Kids-Show starten

# ==========================================
# DONATION SETTINGS
# ==========================================
DONATION_POOL_ID='abc123?sr=example'
DONATION_CAMPAIGN_NAME=Spendenaktion Lichtershow
DONATION_SUBTITLE=Unterstütze unsere Lichtershow!
DONATION_TEXT=Deine Spende hilft uns, die Lichtershow auch im nächsten Jahr zu ermöglichen.
# Buy Me a Coffee Username (optional, wenn gesetzt erscheint ein Button)
BUYMEACOFFEE_USERNAME=

# ==========================================
# SOCIAL MEDIA (optional, leer lassen wenn nicht genutzt)
# Icons werden im Footer angezeigt, wenn die Variable einen Wert hat
# ==========================================
SOCIAL_FACEBOOK=
SOCIAL_INSTAGRAM=
SOCIAL_TIKTOK=
SOCIAL_WHATSAPP=
SOCIAL_YOUTUBE=
SOCIAL_WEBSITE=
SOCIAL_EMAIL=

# ==========================================
# BENACHRICHTIGUNGEN
# Smartphone-Benachrichtigungen bei Benutzeraktionen (Show-Start, Liedwünsche)
# ==========================================

# Benachrichtigungen aktivieren/deaktivieren (true/false)
NOTIFY_ENABLED=false

# --- MQTT (z.B. für Home Assistant, MQTT-Broker) ---
# MQTT-Broker kann lokal (z.B. Mosquitto) oder in Home Assistant integriert sein
NOTIFY_MQTT_ENABLED=false
NOTIFY_MQTT_BROKER=192.168.1.100
NOTIFY_MQTT_PORT=1883
NOTIFY_MQTT_USERNAME=
NOTIFY_MQTT_PASSWORD=
NOTIFY_MQTT_TOPIC=fpp-control/notifications
NOTIFY_MQTT_USE_TLS=false

# --- ntfy.sh (Push-Benachrichtigungen) ---
# ntfy.sh ist ein einfacher Push-Dienst (kann auch selbst gehostet werden)
# App für Android/iOS verfügbar: https://ntfy.sh
# Einfach Topic-Name vergeben und in der App abonnieren
NOTIFY_NTFY_ENABLED=false
NOTIFY_NTFY_URL=https://ntfy.sh
NOTIFY_NTFY_TOPIC=
NOTIFY_NTFY_TOKEN=

# --- Home Assistant Webhook ---
# Direktintegration mit Home Assistant über Webhook
# URL-Format: http://homeassistant.local:8123/api/webhook/WEBHOOK_ID
NOTIFY_HOMEASSISTANT_ENABLED=false
NOTIFY_HOMEASSISTANT_URL=
NOTIFY_HOMEASSISTANT_TOKEN=

# --- Generischer Webhook ---
# Für eigene Integrationen (z.B. Nextcloud, Signal-Bots, etc.)
# Headers als JSON-String, z.B.: {"Authorization": "Bearer TOKEN"}
NOTIFY_WEBHOOK_ENABLED=false
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_METHOD=POST
NOTIFY_WEBHOOK_HEADERS=
